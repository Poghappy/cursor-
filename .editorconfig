# EditorConfig is awesome: https://EditorConfig.org

# 顶级配置文件
root = true

# 所有文件的默认配置
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# TypeScript/JavaScript 文件
[*.{js,ts,jsx,tsx}]
indent_size = 2
quote_type = single

# JSON 文件
[*.json]
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_size = 2

# Markdown 文件
[*.md]
trim_trailing_whitespace = false
max_line_length = 100

# Makefile
[Makefile]
indent_style = tab

# Shell 脚本
[*.sh]
indent_size = 2
end_of_line = lf

# Python 文件
[*.py]
indent_size = 4

# package.json 特殊处理
[package.json]
indent_size = 2

