{
  "name": "cursor-multi-role-agent-team",
  "version": "1.0.0",
  "description": "Cursor 多角色 Agent 团队模板 - 0→1 自主交付",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:performance": "jest --testPathPattern=performance",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "clean": "rimraf dist coverage",
    "docs": "typedoc src --out docs/api",
    "docs:serve": "http-server docs/api -p 8080",
    "db:migrate": "knex migrate:latest",
    "db:seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "deploy:dev": "npm run build && npm run test && npm run deploy:dev:script",
    "deploy:staging": "npm run build && npm run test && npm run deploy:staging:script",
    "deploy:prod": "npm run build && npm run test && npm run deploy:prod:script",
    "deploy:dev:script": "echo 'Deploying to dev environment...'",
    "deploy:staging:script": "echo 'Deploying to staging environment...'",
    "deploy:prod:script": "echo 'Deploying to production environment...'",
    "rollback": "echo 'Rolling back to previous version...'",
    "backup": "echo 'Creating backup...'",
    "restore": "echo 'Restoring from backup...'",
    "monitor": "echo 'Starting monitoring...'",
    "report": "npm run test:coverage && npm run lint && npm audit",
    "setup": "npm install && npm run db:migrate && npm run db:seed",
    "quick-start": "npm run setup && npm run dev",
    "quick-test": "npm run lint && npm run test",
    "quick-build": "npm run clean && npm run build && npm run test",
    "full-cycle": "npm run clean && npm run install && npm run lint && npm run test && npm run build && npm run test:coverage",
    "check-env": "node scripts/check-env.js",
    "update": "npm update",
    "outdated": "npm outdated",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "cursor",
    "agent",
    "team",
    "multi-role",
    "autonomous",
    "delivery",
    "template"
  ],
  "author": "Cursor Multi-Role Agent Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",

    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.10.9",
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.8",
    "@types/supertest": "^2.0.16",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "typedoc": "^0.25.4",
    "http-server": "^14.1.1",
    "knex": "^3.1.0",
    "pg": "^8.11.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src", "<rootDir>/tests"],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts",
      "!src/**/*.spec.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "@typescript-eslint/no-non-null-assertion": "warn",
      "prefer-const": "error",
      "no-var": "error"
    },
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/cursor-multi-role-agent-team.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/cursor-multi-role-agent-team/issues"
  },
  "homepage": "https://github.com/your-org/cursor-multi-role-agent-team#readme"
}
